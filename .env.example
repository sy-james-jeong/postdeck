# Copy to .env (gitignored). Hongix Notion integration.
NOTION_TOKEN=secret_xxx
NOTION_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# L2 AI writing (postdeck write). Provider: "gemini" (default, cheapest), "anthropic", or "openai".
POSTDECK_LLM=gemini
# Gemini key (default provider) — get one at aistudio.google.com.
GEMINI_API_KEY=...
# Anthropic/Claude key (used only when POSTDECK_LLM=anthropic). Or `ant auth login`.
ANTHROPIC_API_KEY=sk-ant-xxx
# OpenAI/ChatGPT key (used only when POSTDECK_LLM=openai).
OPENAI_API_KEY=sk-xxx
# Optional model overrides (providers rotate model ids):
# POSTDECK_GEMINI_MODEL=gemini-3.6-flash
# POSTDECK_OPENAI_MODEL=gpt-4o-mini
